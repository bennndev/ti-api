# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require&channel_binding=require"

# API
BETTER_AUTH_URL="http://localhost:3000"
PORT=3000

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth Apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# JWT for external clients (XR, mobile, microservices)
# Secret key for HS256 signing. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"
# Token expiration duration (e.g. 7d, 24h, 30d)
JWT_EXPIRY="7d"

# Frontend URL for CORS (production deployment)
# Example: https://ti-web-sigma.vercel.app
FRONTEND_URL=""
